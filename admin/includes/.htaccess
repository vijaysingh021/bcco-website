# ==============================================================================
# BCCO Admin Includes - Strict Direct Access Denial
# Protects configuration files, database credentials, and core logic.
# ==============================================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

