# ==============================================================================
# BCCO Uploads Directory - Strict Execution & Exploitation Lockdown
# Ensures files uploaded by users can NEVER execute server-side code
# ==============================================================================

# Disable directory indexing and CGI execution
Options -Indexes -ExecCGI -Includes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh .bash .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh .bash .phar

# Turn off PHP engines in Apache
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block all script and executable file extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|com|msi|vbs|vbe|wsf|wsh|hta|jar|jsp|asp|aspx|cer|csr|shtml|env|config|sql|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow safe static image assets
<FilesMatch "(?i)\.(jpg|jpeg|png|webp|gif|ico|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Set strict security headers on uploaded files
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Disposition "inline"
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
