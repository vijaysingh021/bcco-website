# ==============================================================================
# Bihar Cancer Care Organisation (BCCO) - Apache .htaccess Configuration
# Optimized for GoDaddy cPanel Linux Hosting (Apache 2.4+)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DIRECTORY LISTING & HIDDEN FILES PROTECTION
# ------------------------------------------------------------------------------
Options -Indexes
Options -MultiViews

# Block access to hidden files (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. CUSTOM ERROR DOCUMENT
# ------------------------------------------------------------------------------
# In cPanel public_html, this points to 404.html
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 3. CANONICAL REDIRECTS (HTTPS & WWW)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Option A: Force HTTPS and redirect non-www to www (Default)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

    # Option B: If you prefer apex/non-www (e.g. https://yourdomain.com),
    # comment out Option A above and uncomment the 3 lines below:
    # RewriteCond %{HTTPS} off [OR]
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 4. COMPRESSION (MOD_DEFLATE)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------------------------
# 5. BROWSER CACHING (MOD_EXPIRES & CACHE-CONTROL)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: Short cache (no-cache / revalidate)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript: 1 year (static versioned)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images: 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

    # Web Manifest & JSON data
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # 1 year immutable cache for assets
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 6. SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict risky browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy (allows self-hosted assets, inline SVG symbols, and self API)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# ------------------------------------------------------------------------------
# 7. MIME TYPES FOR MODERN ASSETS
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

