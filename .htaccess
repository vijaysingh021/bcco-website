# ==============================================================================
# Bihar Cancer Care Organisation (BCCO) - Enterprise Apache Security & Performance
# Hardened for GoDaddy cPanel Linux Hosting (Apache 2.4+)
# Includes: DDoS Mitigation, Anti-Bruteforce, Bot Blocking, WAF Rules, & Security Headers
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER SIGNATURE & DIRECTORY PROTECTION
# ------------------------------------------------------------------------------
ServerSignature Off
Options -Indexes -MultiViews

# Block access to hidden files and directories (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to sensitive configuration, database and project files
<FilesMatch "(?i)\.(env|config|ini|log|sql|sqlite|db|bak|backup|old|orig|sh|bash|yml|yaml|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block server & build script files from public execution
<FilesMatch "^(server\.js|build-minify\.js|test_.*\.js|composer\.json|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. DDOS MITIGATION & RESOURCE EXHAUSTION PROTECTION
# ------------------------------------------------------------------------------
# Limit request body to 10MB to prevent memory exhaustion / slow HTTP POST attacks
LimitRequestBody 10485760

# ------------------------------------------------------------------------------
# 3. CUSTOM ERROR DOCUMENTS
# ------------------------------------------------------------------------------
ErrorDocument 400 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# ------------------------------------------------------------------------------
# 4. WEB APPLICATION FIREWALL (WAF) & ATTACK SHIELD
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 4.1 Block Unsafe HTTP Methods (prevent TRACE/TRACK/CONNECT abuse)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT|DEBUG) [NC]
    RewriteRule ^ - [F,L]

    # 4.2 Block Known Vulnerability & Scanner Probe URLs
    RewriteCond %{REQUEST_URI} ^/(wp-login|wp-admin|xmlrpc\.php|wp-content|phpmyadmin|pma|adminer|cgi-bin|\.git|\.env|core\.php|config\.php) [NC]
    RewriteRule ^ - [F,L]

    # 4.3 Block Bad User-Agents (DDoS Flooders, Exploit Scanners, Scrapers)
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|havij|acunetix|masscan|zgrab|nmap|dirbuster|gobuster|libwww-perl|Morfeus|ZmEu|scan|miner|python-urllib|perl|curl|Go-http-client) [NC]
    # Allow legitimate bots (Google, Bing, Yahoo, DuckDuckGo)
    RewriteCond %{HTTP_USER_AGENT} !(Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot) [NC]
    RewriteRule ^ - [F,L]

    # 4.4 Block SQL Injection Patterns in Query Strings
    RewriteCond %{QUERY_STRING} (union.*select|information_schema|benchmark\(|sleep\(|concat\(|drop\s+table|insert\s+into|select.*from|char\(|waitfor\s+delay) [NC,OR]
    RewriteCond %{QUERY_STRING} (\%27|\')(\s*)(or|and)(\s*)(\%27|\'|[0-9]+=[0-9]+) [NC,OR]
    RewriteCond %{QUERY_STRING} (\;|<|>|\'|\"|\)|%0A|%0D|%22|%27|%3C|%3E|%00).*(/\*|union|select|insert|cast|set|declare|drop|md5|benchmark) [NC]
    RewriteRule ^ - [F,L]

    # 4.5 Block Cross-Site Scripting (XSS) Patterns in Query Strings
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript:|vbscript:|onload=|onerror=|onclick=|document\.cookie) [NC]
    RewriteRule ^ - [F,L]

    # 4.6 Block Path Traversal & Remote File Inclusion (RFI)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e\/) [NC,OR]
    RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|win\.ini|windows/system32) [NC,OR]
    RewriteCond %{QUERY_STRING} =(https?|ftp|php): [NC]
    RewriteRule ^ - [F,L]

    # 4.7 Block Base64 Execution Exploits
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode|eval\(|gzinflate) [NC]
    RewriteRule ^ - [F,L]

    # --------------------------------------------------------------------------
    # 5. CANONICAL REDIRECTS (APEX NON-WWW & HTTPS)
    # --------------------------------------------------------------------------
    # 1. Canonical Apex Redirect (redirect www.bcco.ngo to bcco.ngo)
    RewriteCond %{HTTP_HOST} ^www\.bcco\.ngo$ [NC]
    RewriteRule ^ %{REQUEST_SCHEME}://bcco.ngo%{REQUEST_URI} [L,NE,R=301]

    # 2. Force HTTPS Redirect (Canonical: https://bcco.ngo/)
    # Once SSL is confirmed active on GoDaddy/cPanel, uncomment the two lines below:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://bcco.ngo%{REQUEST_URI} [L,NE,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 6. COMPRESSION (MOD_DEFLATE)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ------------------------------------------------------------------------------
# 7. BROWSER CACHING (MOD_EXPIRES & CACHE-CONTROL)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: Short cache (revalidate)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript: 1 year (static versioned)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images: 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

    # Web Manifest & JSON data
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # 1 year immutable cache for assets
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 8. HARDENED SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Cross-Site Scripting filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Cross-Origin isolation
    Header set Cross-Origin-Opener-Policy "same-origin"

    # Restrict risky browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy (allows self-hosted assets, inline SVG symbols, self API, and AI web data sources)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self' data:; connect-src 'self' https://en.wikipedia.org https://api.duckduckgo.com https://generativelanguage.googleapis.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# ------------------------------------------------------------------------------
# 9. MIME TYPES FOR MODERN ASSETS
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>
